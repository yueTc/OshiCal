{
  "name": "oshical",
  "private": true,
  "version": "0.3.5",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build:web": "tsc -b && vite build",
    "build:core": "cargo build -p oshical-core",
    "build:server": "cargo build -p oshical-server",
    "build:desktop": "tauri build",
    "build:portable": "tauri build --no-bundle",
    "build": "npm run build:web && cargo build --workspace",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "dev:server": "cargo run -p oshical-server",
    "test": "cargo test --workspace",
    "test:web": "node --experimental-strip-types --test scripts/live-schedule.test.ts scripts/server-url.test.ts scripts/github-mirror.test.ts scripts/fan-history.test.ts scripts/timeline-layout.test.ts scripts/fertility.test.ts",
    "check": "cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && tsc -b --pretty false",
    "version:set": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "2.4.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.545.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
