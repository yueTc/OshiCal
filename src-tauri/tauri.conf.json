{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OshiCal",
  "version": "0.3.6",
  "identifier": "com.oshical.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "推历 OshiCal · 直播日程",
        "width": 1280,
        "height": 820,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: https://*.hdslb.com; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "OshiCal",
    "copyright": "Copyright © 2026 OshiCal contributors",
    "shortDescription": "虚拟主播直播日程与开播提醒",
    "longDescription": "推历 OshiCal 汇总 B 站虚拟主播动态、直播预约和图片日程，并在开播时发送通知。",
    "category": "Entertainment",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4OTI1RTZBQkZBNkQxQ0QKUldUTjBhYS9hbDZTU05YMkoyb1RmbFBHZXBCVjV3aUd6QlBNeXlIWTJWSU04dHFHTXBnWnNFNmIK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/yueTc/OshiCal/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
