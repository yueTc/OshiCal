# Container image used by docker compose. Pin a version for reproducible production deployments.
OSHICAL_IMAGE=ghcr.io/yuetc/oshical-server:0.3.30

# Server bind address. Use 0.0.0.0 only when remote clients are intended.
OSHICAL_BIND=127.0.0.1:8787
# Required when OSHICAL_BIND is not loopback.
OSHICAL_API_TOKEN=
# Optional path override.
OSHICAL_DB_PATH=./data/oshical.db
# Directory shared with the host-side updater agent.
OSHICAL_UPDATE_DIR=./data/system
# Optional Bilibili SESSDATA cookie. Never commit real values.
OSHICAL_BILI_COOKIE=
# OpenAI-compatible vision endpoint settings.
OSHICAL_LLM_BASE_URL=https://api.openai.com/v1
OSHICAL_LLM_API_KEY=
# Optional stable 32+ character master key used to encrypt server-side credentials at rest.
# If omitted, OshiCal creates a random master-key file next to the database and restricts it
# to the current service account. Back up that file together with the database.
# Do not change or delete the key after secrets are saved; restore the original key or
# re-save the affected credentials in Settings.
OSHICAL_SECRETS_KEY=
# Optional path override for the generated random master-key file.
# The file must live outside the database and be backed up with it.
OSHICAL_SECRETS_KEY_FILE=
OSHICAL_LLM_MODEL=

# YouTube Data API v3 keys are user-scoped. Each user must save their own key
# in Settings after enabling YouTube; OSHICAL_YOUTUBE_API_KEY is intentionally ignored.
# Optional short-lived access token seed. Normal deployments should complete OAuth
# in Settings so the refresh token can be encrypted in SecretVault.
OSHICAL_YOUTUBE_OAUTH_ACCESS_TOKEN=
# Google OAuth credentials for live chat, Super Chat and membership events.
# Server deployments use a Web application client and require both values.
# Desktop builds use the same OSHICAL_YOUTUBE_CLIENT_ID variable at build/launch time,
# but the OAuth client type must be Desktop app and the client secret must never be shipped.
OSHICAL_YOUTUBE_CLIENT_ID=
OSHICAL_YOUTUBE_CLIENT_SECRET=
# Server callback. Must exactly match an authorized redirect URI in the Google OAuth client.
# Loopback bind addresses default to http://<bind>/api/youtube/oauth/callback; non-loopback hosts must use https.
# Desktop uses a temporary http://127.0.0.1:<port> loopback URI with PKCE;
# register a loopback redirect for the Desktop OAuth client in Google Cloud.
OSHICAL_YOUTUBE_OAUTH_REDIRECT_URI=
# Optional encrypted seed for member-only community posts. Importing the session later replaces it.
OSHICAL_YOUTUBE_WEB_SESSION_COOKIE=

# Poll intervals in seconds.
OSHICAL_LIVE_POLL_SECONDS=20
OSHICAL_DYNAMIC_POLL_SECONDS=300
# Optional local HTTP proxy port used for outbound Bilibili/model requests.
OSHICAL_PROXY_PORT=


# Static web assets directory.
OSHICAL_WEB_DIR=./dist
